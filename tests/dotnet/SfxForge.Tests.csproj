<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity package's engine-independent code (Runtime/Core) without Unity: dotnet run -c Release.
       Every .cs file of this folder is part of the program: Program.cs has Main and says what the others hold. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);SFX_WINDOWS</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\unity\com.catsplat.sfxforge\Runtime\Core\*.cs" />
    <None Include="..\..\unity\com.catsplat.sfxforge\Runtime\Plugins\x86_64\sfxforge.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
